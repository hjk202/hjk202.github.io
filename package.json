{
  "name": "personal-space",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro check && tsc --noEmit -p studio/tsconfig.json",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:extension": "node tests/verify-extension.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "studio": "npm run studio:build && node --experimental-strip-types studio/server/main.ts",
    "studio:open": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File studio/windows/Open.ps1",
    "studio:stop": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File studio/windows/Stop.ps1",
    "studio:configure": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File studio/windows/Configure.ps1",
    "studio:build": "vite build --config studio/vite.config.ts",
    "studio:test": "npm run studio:build && playwright test --config tests/studio/playwright.config.ts",
    "prebuild": "node --experimental-strip-types scripts/vault/check-public.mjs",
    "vault:pack": "node --experimental-strip-types scripts/vault/cli.mjs pack",
    "vault:verify": "node --experimental-strip-types scripts/vault/cli.mjs verify",
    "vault:rekey": "node --experimental-strip-types scripts/vault/cli.mjs rekey",
    "vault:backup": "node --experimental-strip-types scripts/vault/cli.mjs backup",
    "vault:restore": "node --experimental-strip-types scripts/vault/cli.mjs restore"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1",
    "vite": "8.3.4",
    "ultrahtml": "1.7.0",
    "entities": "4.5.0",
    "@astrojs/markdown-satteri": "0.4.3"
  }
}
