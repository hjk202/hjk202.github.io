<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StudioNativeOutput Condition="'$(StudioNativeOutput)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\.cache\studio\desktop\app</StudioNativeOutput>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../studio/desktop/Boundary.cs" Link="Boundary.cs" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(StudioNativeOutput)/Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(StudioNativeOutput)/Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <Content Include="$(StudioNativeOutput)/runtimes/win-x64/native/WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
