---
import { bookmarks } from './data';
import { bookmarkGroups } from './bookmarks';
import './background.css';
import { withBase } from '../../core/module/urls';
const groups = bookmarkGroups(bookmarks);
const route = withBase('/keep/', import.meta.env.BASE_URL);
---
<div class="keep-directory" data-bookmark-directory>
  <header class="keep-heading"><p class="eyebrow">A CURATED CORNER OF THE WEB</p><h1>收藏夹</h1><p>整理过的网站、课程和工具。<br />给值得留下来的东西，一个好找的位置。</p></header>
  {bookmarks.length ? <>
    <nav class="category-filter glass-control" aria-label="收藏分类">
      <a href={route} data-category-filter="all" aria-current="true">全部 <span>{bookmarks.length}</span></a>
      {groups.map((group) => <a href={`${route}?category=${group.id}`} data-category-filter={group.id}>{group.label} <span>{group.entries.length}</span></a>)}
    </nav>
    <p class="category-status" data-category-status aria-live="polite">共 {bookmarks.length} 项收藏</p>
    {groups.map((group) => <section class="bookmark-group" data-bookmark-group={group.id} aria-labelledby={`category-${group.id}`}>
      <header><h2 id={`category-${group.id}`}>{group.label}</h2><span>{group.entries.length} 项收藏</span></header>
      <div class="bookmark-grid" data-single={group.entries.length === 1 ? 'true' : 'false'}>
        {group.entries.map((bookmark) => <article class="bookmark-card">
          <div class="bookmark-source"><span class="source-symbol" aria-hidden="true">{new URL(bookmark.sourceUrl).hostname[0].toUpperCase()}</span><span>{new URL(bookmark.sourceUrl).hostname}</span>{bookmark.kind && <span class="resource-kind">{bookmark.kind}</span>}</div>
          <h3><a href={withBase(`/keep/${bookmark.slug}/`, import.meta.env.BASE_URL)} data-bookmark-detail>{bookmark.title}</a></h3>
          <p>{bookmark.description}</p>
          <footer><a class="text-link" href={withBase(`/keep/${bookmark.slug}/`, import.meta.env.BASE_URL)} data-bookmark-detail>查看收藏说明 <span aria-hidden="true">→</span></a><a class="text-link" href={bookmark.sourceUrl} target="_blank" rel="noopener noreferrer">打开网站 <span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a></footer>
        </article>)}
      </div>
    </section>)}
  </> : <p>暂无公开收藏。</p>}
</div>
<script>
  import { onPage } from '../../shell/layout/lifecycle';
  onPage(() => {
  const abort = new AbortController();
  const directory = document.querySelector<HTMLElement>('[data-bookmark-directory]');
  if (directory?.querySelector('[data-category-status]')) {
    const groups = [...directory.querySelectorAll<HTMLElement>('[data-bookmark-group]')];
    const filters = [...directory.querySelectorAll<HTMLAnchorElement>('[data-category-filter]')];
    const apply = () => {
      const url = new URL(location.href);
      const requested = url.searchParams.get('category');
      const selected = groups.some((group) => group.dataset.bookmarkGroup === requested) ? requested! : 'all';
      if (requested && selected === 'all') { url.searchParams.delete('category'); history.replaceState(null, '', url); }
      groups.forEach((group) => { group.hidden = selected !== 'all' && group.dataset.bookmarkGroup !== selected; });
      filters.forEach((filter) => { if (filter.dataset.categoryFilter === selected) filter.setAttribute('aria-current', 'true'); else filter.removeAttribute('aria-current'); });
      const visibleCount = groups.filter((group) => !group.hidden).reduce((total, group) => total + group.querySelectorAll('.bookmark-card').length, 0);
      directory.querySelector('[data-category-status]')!.textContent = `共 ${visibleCount} 项收藏`;
      directory.querySelectorAll<HTMLAnchorElement>('[data-bookmark-detail]').forEach((link) => {
        const target = new URL(link.href);
        if (selected === 'all') target.searchParams.delete('category'); else target.searchParams.set('category', selected);
        link.href = target.href;
      });
    };
    filters.forEach((filter) => filter.addEventListener('click', (event) => {
      if (event.button || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
      event.preventDefault(); history.pushState(null, '', filter.href); apply();
    }, { signal: abort.signal }));
    window.addEventListener('popstate', apply, { signal: abort.signal });
    window.addEventListener('pageshow', apply, { signal: abort.signal });
    apply();
  }
  return () => abort.abort();
  });
</script>
