---
import { profile } from './data';
import './background.css';
import { withBase } from '../../core/module/urls';
---
<article class="profile">
  {profile ? <>
    <div class="profile-hero">
    <div class="profile-identity">
    <p class="eyebrow">HAN JIANGKAI / A PERSONAL SPACE</p>
    <h1>{profile.name}</h1>
    <p class="profile-intro">{profile.description}</p>
    <h2 class="profile-motto">把复杂的东西拆开，<br />再亲手构建。</h2>
    <p class="profile-directions">SYSTEMS <span>·</span> AI <span>·</span> MAKING</p>
    </div>
    <div class="profile-object" aria-hidden="true"><div class="personal-lens"><i></i><i></i><span>HJ</span></div><p>UNDERSTAND / BUILD / CONNECT</p></div>
    </div>
    <div data-vault-slot></div><div class="vault-public-heading"><p class="eyebrow">PUBLIC / 公开</p><h2>与外界分享的我</h2></div>
    <section class="profile-story" aria-labelledby="story-title">
      <div><p class="eyebrow">01 / ABOUT ME</p><h2 id="story-title">从一个问题，<br />继续往下。</h2></div>
      <div>{profile.paragraphs.map((text) => <p>{text}</p>)}</div>
    </section>
    <section class="profile-interests" aria-label="兴趣方向">
      <div><span class="eyebrow">01 / SYSTEMS</span><h2>系统</h2><p>CPU 模拟器、操作系统与 TCP。</p></div>
      <div><span class="eyebrow">02 / INTELLIGENCE</span><h2>人工智能</h2><p>从 Attention 到 GQA，追问基本操作。</p></div>
      <div><span class="eyebrow">03 / MAKING</span><h2>构建</h2><p>让理解变成真正运行起来的东西。</p></div>
    </section>
    <div class="profile-explore"><a class="text-link" href={withBase('/think/', import.meta.env.BASE_URL)}>正在思考 <span aria-hidden="true">↗</span></a><a class="text-link" href={withBase('/build/', import.meta.env.BASE_URL)}>真正构建 <span aria-hidden="true">↗</span></a>{profile.links?.map((link) => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span><span class="sr-only">（新标签页）</span></a>)}</div>
  </> : <><h1>Me</h1><div data-vault-slot></div><p>暂无公开介绍。</p></>}
</article>
