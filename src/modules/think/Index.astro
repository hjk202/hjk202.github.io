---
import { posts } from './content.server';
import './background.css';
import { withBase } from '../../core/module/urls';
const articles = posts.filter((post) => post.metadata.kind !== 'note');
const notes = posts.filter((post) => post.metadata.kind === 'note');
---
<div class="thought-space">
  <header class="thought-heading">
    <div><p class="eyebrow">THINK / A GARDEN OF QUESTIONS</p><h1>想法不必<br />一开始就有答案。</h1><p class="thought-deck">在理解、好奇和不确定之间，<br />留一点空间给新的问题。</p></div>
    <div class="thought-object" aria-hidden="true"><span class="thought-petal"></span><span class="thought-petal"></span><span class="thought-petal"></span><i class="thought-star">✳</i><i class="thought-seed"></i><small>∴</small></div>
  </header>
  {articles.length > 0 && <section class="thought-reading" aria-labelledby="reading-title"><div class="thought-section-label"><p class="eyebrow">TAKE A MOMENT</p><h2 id="reading-title">慢慢读。</h2><span>{articles.length} 篇文章</span></div><div class="thought-articles">{articles.map(({metadata: post}) => <article class="thought-entry"><p class="eyebrow"><time datetime={post.date}>{post.date}</time> / 文章</p><h2><a href={withBase(`/think/${post.slug}/`, import.meta.env.BASE_URL)}>{post.title}</a></h2><p>{post.summary}</p><a class="text-link" href={withBase(`/think/${post.slug}/`, import.meta.env.BASE_URL)}>阅读这篇文章 <span aria-hidden="true">↗</span></a></article>)}</div></section>}
  {notes.length > 0 && <section class="thought-notes" aria-label="随记"><h2>随手留下一点想法。</h2>{notes.map((post) => { const Content = post.Content; return <article class="thought-note"><p class="eyebrow"><time datetime={post.metadata.date}>{post.metadata.date}</time> / 随记</p><h3><a href={withBase(`/think/${post.metadata.slug}/`, import.meta.env.BASE_URL)}>{post.metadata.title}</a></h3><div class="note-body"><Content /></div></article>; })}</section>}
  {!posts.length && <p>暂无公开文章。</p>}
</div>
