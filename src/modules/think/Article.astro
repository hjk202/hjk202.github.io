---
import { posts } from './content.server';
import './background.css';
import { withBase } from '../../core/module/urls';
interface Props { post: (typeof posts)[number] }
const { post } = Astro.props;
const Content = post.Content;
---
<article class="think-article">
  <a class="text-link think-return" href={withBase('/think/', import.meta.env.BASE_URL)}>← 返回 Think</a>
  <time datetime={post.metadata.date}>{post.metadata.date}</time>
  <h1>{post.metadata.title}</h1>
  <p class="summary">{post.metadata.summary}</p>
  <div class="prose"><Content /></div>
</article>
<style>
  article { overflow-wrap: anywhere; max-width: 720px; margin: auto; }
  .think-return { margin-bottom: 36px; }
  time { font-size: .75rem; color: var(--muted); }
  .think-article h1 { font-size: clamp(1.65rem, 4vw, 2.4rem); line-height: 1.5; margin: 1rem 0 1.6rem; text-wrap: balance; }
  .summary { color: var(--muted); line-height: 1.9; border-bottom: 1px solid var(--edge); padding-bottom: 2rem; margin-bottom: 2.4rem; }
  .prose { line-height: 1.95; }
  .prose :global(p) { margin: 1.5rem 0; }
  .prose :global(h2), .prose :global(h3) { margin-top: 2.5rem; line-height: 1.5; }
  .prose :global(li) { margin: .5rem 0; }
  .prose :global(blockquote) { margin: 2rem 0; padding-left: 1.25rem; border-left: 2px solid var(--edge); color: var(--muted); }
  .prose :global(code) { font-size: .85em; background: var(--selection); padding: .15em .35em; border-radius: 4px; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: 1.25rem; border: 1px solid var(--edge); border-radius: 10px; line-height: 1.65; }
  .prose :global(pre code) { padding: 0; background: transparent; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(.attention-equation) { display: flex; justify-content: safe center; align-items: center; gap: .5rem; max-width: 100%; overflow-x: auto; padding: 1.5rem 0; font: 1.5rem Georgia, serif; }
  .prose :global(.attention-equation > *) { flex-shrink: 0; }
  .prose :global(.fraction) { display: inline-flex; flex-direction: column; text-align: center; }
  .prose :global(.fraction > span:first-child) { border-bottom: 1px solid currentColor; padding: 0 .3rem .3rem; }
  .prose :global(.fraction > span:last-child) { padding-top: .3rem; }
</style>
