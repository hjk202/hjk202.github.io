<dialog class="vault-dialog" data-vault-dialog aria-labelledby="vault-title">
  <button type="button" class="vault-close" data-vault-close aria-label="关闭私人空间">×</button>
  <p class="eyebrow">A LITTLE FURTHER WITHIN</p>
  <h2 id="vault-title">Unlock</h2>
  <p class="vault-caption">那些更里面的东西。</p>
  <div data-vault-form hidden>
    <label for="vault-passphrase">口令</label>
    <input id="vault-passphrase" type="password" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" aria-label="私人空间口令" aria-describedby="vault-status" />
    <button type="button" class="glass-control vault-submit" data-vault-submit>解锁</button>
  </div>
  <p id="vault-status" role="status" aria-live="polite"></p>
  <button type="button" class="vault-retry text-link" data-vault-retry hidden>重试</button>
</dialog>
<script>import './unlock';</script>
<style is:global>
  .header-actions { display: flex; align-items: center; gap: 8px; }
  .vault-open { overflow: hidden; }
  .vault-dialog { position: fixed; inset: 0; width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; margin: auto; padding: 36px; border: 1px solid var(--edge); border-radius: 24px; color: var(--ink); background: var(--surface); box-shadow: 0 28px 70px #10263220, inset 0 1px 0 var(--glass-highlight); }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) { .vault-dialog { background: linear-gradient(180deg, var(--lens-light), transparent 40%), var(--glass); backdrop-filter: blur(24px) saturate(1.08); -webkit-backdrop-filter: blur(24px) saturate(1.08); } }
  .vault-dialog::backdrop { background: var(--backdrop); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .vault-dialog .eyebrow { margin: 0 0 12px; font-size: .58rem; }
  .vault-dialog h2 { margin: 0; font: 400 2.5rem/1.2 'Iowan Old Style', Georgia, serif; letter-spacing: -.04em; }
  .vault-caption { color: var(--muted); margin: 12px 0 30px; font-size: .9rem; }
  .vault-close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; border: 0; border-radius: 50%; color: var(--muted); background: transparent; font-size: 1.5rem; cursor: pointer; }
  .vault-dialog label { display: block; font-size: .7rem; color: var(--muted); margin-bottom: 8px; }
  .vault-dialog input { width: 100%; min-height: 48px; border: 1px solid var(--edge); border-radius: 12px; padding: 10px 14px; background: var(--surface); color: var(--ink); font: inherit; font-size: 16px; }
  .vault-submit { margin-top: 16px; width: 100%; min-height: 44px; color: var(--ink); }
  .vault-submit:disabled { opacity: .55; cursor: wait; }
  #vault-status { margin: 18px 0 0; font-size: .8rem; color: var(--muted); line-height: 1.65; }
  .vault-retry { border: 0; background: transparent; color: var(--ink); min-height: 44px; padding: 0; margin-top: 8px; cursor: pointer; }
  .vault-retry[hidden] { display: none; }
  @media (max-width: 600px), (max-height: 500px) { .vault-dialog { padding: 28px 24px; } .vault-caption { margin-bottom: 20px; } }
</style>
