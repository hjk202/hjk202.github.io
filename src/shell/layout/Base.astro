---
import Spotlight from '../home/Spotlight.astro';
import '../theme/theme.css';
import '../glass/glass.css';
import { withBase } from '../../core/module/urls';
import { ClientRouter } from 'astro:transitions';
import { searchIndex } from '../../core/search/index.server';
import Unlock from '../vault/Unlock.astro';
interface Props { title: string; description?: string; noindex?: boolean }
const { title, description = 'Personal Space：从Compass探索模块，用Spotlight查找公开内容。', noindex = false } = Astro.props;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN" data-base={import.meta.env.BASE_URL} transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg', import.meta.env.BASE_URL)} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body><slot /><Spotlight /><Unlock /><script type="application/json" data-vault-public set:html={JSON.stringify(searchIndex).replaceAll('<', '\\u003c')} /></body>
</html>
<script>import '../vault/runtime';</script>
<style is:global>
  :root { view-transition-name: none !important; }
  [data-vault-hidden] { display: none !important; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 16px/1.65 system-ui, sans-serif; }
  a { color: inherit; text-underline-offset: .25em; }
  button, input { font: inherit; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 5px; }
  .module-content { width: min(100%, var(--content-width, 1120px)); margin: 48px auto 0; padding: 0 40px 96px; }
  .module-content :where(h1) { font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.25; font-weight: 500; letter-spacing: -.04em; }
  .module-content :where(h2) { font-size: 1.25rem; font-weight: 500; }
  .demo-label { font-size: .7rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .content-list { list-style: none; padding: 0; }
  .content-list li { padding: 24px 0; border-bottom: 1px solid var(--edge); }
  .content-list p { margin-bottom: 0; }
  .search-open { overflow: hidden; }
  .eyebrow { font: 500 .68rem/1.5 system-ui, sans-serif; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .text-link { display: inline-flex; align-items: center; gap: 16px; text-decoration: none; font-size: .85rem; }
  .text-link:hover { text-decoration: underline; }
  .quiet-rule { border: 0; border-top: 1px solid var(--edge); }
  @media (max-width: 600px) { .module-content { margin-top: 28px; padding: 0 max(24px, env(safe-area-inset-right)) max(64px, env(safe-area-inset-bottom)) max(24px, env(safe-area-inset-left)); } }
  @media (max-width: 600px), (pointer: coarse) { .text-link { min-height: 44px; } }
</style>
