---
import { searchIndex } from '../core/search/index.server';
import Base from '../shell/layout/Base.astro';
import SearchButton from '../shell/layout/SearchButton.astro';
import Compass from '../shell/home/Compass.astro';
---

<Base title="Personal Space">
  <div class="home">
    <header class="home-header"><span class="identity">HJK<span>PERSONAL SPACE</span></span><SearchButton /></header>
    <main class="home-main" aria-label="Personal Space"><Compass modules={searchIndex.modules} /></main>
    <footer class="home-footer"><h1>Personal Space</h1><p>HAN JIANGKAI</p></footer>
  </div>
</Base>
<style is:global>
  .home {
    position: relative; isolation: isolate; min-height: 100svh; display: grid; grid-template-rows: auto 1fr auto; overflow: clip;
    background: radial-gradient(ellipse at 50% 25%, var(--environment-light), transparent 68%), var(--background);
  }
  .home-header { display: flex; align-items: center; justify-content: space-between; padding: 24px clamp(24px, 5vw, 72px); }
  .identity { display: flex; flex-direction: column; gap: 2px; font-size: 1rem; font-weight: 600; letter-spacing: .11em; }
  .identity span { font-size: .47rem; font-weight: 400; letter-spacing: .2em; color: var(--muted); }
  .home-main { display: grid; place-items: center; }
  .home-footer { text-align: center; padding: 6px 24px 30px; }
  .home-footer h1 { font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif; font-size: clamp(21px, 2vw, 28px); font-weight: 400; margin: 0; letter-spacing: -.025em; line-height: 1.15; }
  .home-footer p { font-size: .55rem; letter-spacing: .24em; color: var(--muted); margin: 10px 0 0; }
</style>
