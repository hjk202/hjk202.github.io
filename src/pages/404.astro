---
import Base from '../shell/layout/Base.astro';
import SearchButton from '../shell/layout/SearchButton.astro';
import { withBase } from '../core/module/urls';
const home = withBase('/', import.meta.env.BASE_URL);
---
<Base title="页面未找到 — Personal Space" description="这个地址没有可访问的页面。返回首页或通过Spotlight继续探索。" noindex>
  <div class="not-found">
    <header><a href={home} aria-label="Home">HJK</a><SearchButton /></header>
    <main>
      <p class="eyebrow">404 / PERSONAL SPACE</p>
      <h1>没有找到这个页面。</h1>
      <p>地址可能已经变化。<br />可以回到首页，或用搜索继续探索。</p>
      <a class="glass-control text-link" href={home}>返回首页 <span aria-hidden="true">↗</span></a>
    </main>
  </div>
</Base>
<style>
  .not-found { min-height: 100svh; display: grid; grid-template-rows: auto 1fr; background: radial-gradient(ellipse at 50% 25%, var(--environment-light), transparent 68%), var(--background); }
  header { display: flex; justify-content: space-between; align-items: center; padding: max(24px, env(safe-area-inset-top)) max(clamp(24px, 5vw, 72px), env(safe-area-inset-right)) 24px max(clamp(24px, 5vw, 72px), env(safe-area-inset-left)); }
  header a { display: inline-flex; align-items: center; min-width: 44px; min-height: 44px; font-weight: 600; letter-spacing: .1em; text-decoration: none; }
  main { text-align: center; align-self: center; justify-self: center; padding: 24px 24px max(96px, env(safe-area-inset-bottom)); max-width: 720px; overflow-wrap: anywhere; }
  h1 { font: 400 clamp(1.7rem, 4vw, 3rem)/1.5 'Songti SC', SimSun, Georgia, serif; }
  main > p:not(.eyebrow) { color: var(--muted); line-height: 1.9; }
  .glass-control { margin-top: 28px; min-height: 44px; }
</style>
